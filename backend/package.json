{
  "name": "backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "connectivity-gate": "node dist/scripts/nba-connectivity-gate.js",
    "smoke:free-sources": "tsx src/scripts/probe-free-sources.ts",
    "smoke:engine": "tsx src/scripts/smoke-engine.ts",
    "clean": "node --input-type=module -e \"import { rmSync } from 'node:fs'; rmSync('dist', { recursive: true, force: true });\"",
    "build": "npm run clean && tsc --project tsconfig.json",
    "typecheck": "tsc --project tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@nba-performance-explorer/contracts": "1.0.0",
    "express": "^5.2.1",
    "parse5": "^8.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.0",
    "@types/supertest": "^7.2.0",
    "supertest": "^7.2.2",
    "tsx": "^4.22.4",
    "vitest": "^4.1.9"
  }
}
