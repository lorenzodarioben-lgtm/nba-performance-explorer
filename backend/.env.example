# Local HTTP port. This value is not secret.
PORT=3001

# Data provider selection: "fixture" or "nba-stats".
# - Absent outside production defaults to "fixture".
# - Tests and CI use "fixture" and never contact NBA.com.
# - Production requires an explicit provider selection.
# No API key or credential is required by either mode. Do NOT place this in a VITE_ variable.
NBA_DATA_PROVIDER=fixture

# Explicitly permit fixture mode when NODE_ENV=production.
# Use this only for an intentionally fixture-backed public demonstration.
# Remove it or set it to false before enabling NBA_DATA_PROVIDER=nba-stats.
NBA_ALLOW_FIXTURE_IN_PRODUCTION=false

# Live NBA.com Stats request timeout in milliseconds.
# Must be an integer from 1000 through 30000. The default is 10000.
# Used only when NBA_DATA_PROVIDER=nba-stats.
NBA_STATS_TIMEOUT_MS=10000

# Sanitized response diagnostics. Off by default; enable only for a controlled diagnostic run.
# When "true", an invalid NBA.com response logs sanitized structural metadata (the parser stage,
# safe schema labels, counts, primitive value categories, and Zod issue codes/paths) — never the
# response body, rows, player values, cookies, headers, tokens, or URLs. Must be exactly "true" or
# "false"; any other value fails startup. Used only when NBA_DATA_PROVIDER=nba-stats.
NBA_STATS_DIAGNOSTICS=false

# Historical 2023-24 league and 2024 playoff tables. `live` (default) fetches Wikipedia and falls
# back to the snapshot committed with the app; `bundled` never contacts Wikipedia (offline demos).
WIKI_ARCHIVE_MODE=live
