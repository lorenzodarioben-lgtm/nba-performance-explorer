# Local HTTP port. This value is not secret.
PORT=3001

# Data provider selection: "fixture" or "nba-stats".
# - Absent outside production defaults to "fixture".
# - Tests and CI use "fixture" and never contact NBA.com.
# - Production must set "nba-stats" explicitly; "fixture" (or absent) in production is a startup error.
# No API key or credential is required by either mode. Do NOT place this in a VITE_ variable.
NBA_DATA_PROVIDER=fixture

# Live NBA.com Stats request timeout in milliseconds. Integer from 1000 through 30000 (default 10000).
# Used only when NBA_DATA_PROVIDER=nba-stats.
NBA_STATS_TIMEOUT_MS=10000
